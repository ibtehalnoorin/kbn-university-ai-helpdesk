# Copy to backend/.env (or project-root .env) and adjust only if needed.
# All defaults already match the existing local project.

KBN_OLLAMA_HOST=http://127.0.0.1:11434
KBN_HOST=127.0.0.1
KBN_PORT=8000
KBN_LOG_LEVEL=INFO

# Existing models / collection are fixed by the protected core modules.
KBN_LLM_MODEL=qwen3:8b
KBN_EMBEDDING_MODEL=nomic-embed-text
KBN_CHROMA_DIR=./local_vector_kb
KBN_COLLECTION_NAME=local_research_kb
KBN_EXPECTED_INDEXED_CHUNKS=38

# Retrieval window. The CLI uses 2; the web helpdesk uses 5 so named contacts
# such as the Vice Chancellor's email are not lost. Set to 2 for exact CLI parity.
KBN_KB_N_RESULTS=5

# Qwen3:8B runs on CPU here and can take several minutes for a generated
# answer. Keep these generous. After the HTTP timeout the backend still waits
# for the worker in the background and stores the late answer in the session.
KBN_REQUEST_TIMEOUT_SECONDS=2400
KBN_LATE_COMPLETION_TIMEOUT_SECONDS=7200
KBN_RETRIEVAL_TIMEOUT_SECONDS=120
KBN_OLLAMA_CHECK_TIMEOUT_SECONDS=8

# Speed layer (runtime overrides; the protected processor.py is unchanged).
# think=false disables Qwen3 reasoning tokens; the caps keep answers concise.
KBN_LLM_THINK=false
KBN_LLM_TEMPERATURE=0.2
KBN_LLM_NUM_CTX=4096
KBN_LLM_NUM_PREDICT=320
KBN_LLM_NUM_THREAD=8
KBN_LLM_KEEP_ALIVE=30m
KBN_LLM_WARMUP=true
KBN_FAST_ANSWERS_ENABLED=true
KBN_ANSWER_CACHE_TTL_SECONDS=900
KBN_ANSWER_CACHE_MAX_ENTRIES=256
KBN_RETRIEVAL_CACHE_TTL_SECONDS=900
KBN_RETRIEVAL_CACHE_MAX_ENTRIES=256

KBN_MAX_PENDING_REQUESTS=16
KBN_MAX_SESSIONS=100
KBN_MAX_MESSAGES_PER_SESSION=500

# Off by default: missing university facts must not be filled with random web text.
# Turning this on will use the existing researcher.py search/scrape fallback and
# label answers as web-sourced, not verified.
KBN_ENABLE_WEB_FALLBACK=false
KBN_STRICT_GROUNDING=true
KBN_ALLOW_GENERAL_QUESTIONS=true

KBN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
KBN_SESSION_STORE_PATH=backend/data/sessions.json
KBN_PROTECTED_MANIFEST_PATH=protected_files.sha256
